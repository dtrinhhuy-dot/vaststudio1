Options -MultiViews
RewriteEngine On

RewriteRule ^MVC/router\.php$ - [L]
RewriteRule ^MVC(?:/|$) - [F,L]
RewriteRule ^$ MVC/router.php [L]
RewriteRule ^(index|products|product-detail|order-tracking|about|contact|auth|auth-api|login|register|checkout|admin|api|sepay-webhook|home|shop)\.php$ MVC/router.php [QSA,L]
